# The OPERATOR API. Production is https://api.yuvoy.in/operator/v1; the local
# Go stack from yuvoy-api's scripts/e2e-local.sh serves :8093.
#
# NOT prefixed NEXT_PUBLIC_. Nothing in this portal talks to the API from a
# browser — /operator/v1 refuses CORS by design — so this value has no business
# being inlined into client JavaScript, and keeping it server-only means a
# leaked bundle does not name the admin origin.
OPERATOR_API_URL=http://localhost:8093/operator/v1

# Set to "enabled" to serve the whole portal from mocks/. Development only.
NEXT_PUBLIC_API_MOCKING=enabled

# The visitor's address for the API's per-IP limits (yuvoy-api#282 item 3).
# Server only: never prefix it NEXT_PUBLIC_. With it set, this portal's server
# sends the visitor's address (Vercel's x-real-ip) and this secret to the API,
# which counts the visitor rather than Vercel, a sign-in code above all. The
# SAME value as the API's PROXY_CLIENT_IP_SECRET, at least 32 characters
# (openssl rand -hex 32). Unset, nothing is sent and the API counts Vercel, as
# before. In Vercel it may be Sensitive: it is read at run time, not at build
# time.
PROXY_CLIENT_IP_SECRET=
